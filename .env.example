# ==============================================================================
# ClaimFlow Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Never commit '.env' to version control!
# ==============================================================================

# Active Spring Profile: 'dev' (local H2 in-memory) or 'postgres' (Supabase PostgreSQL)
SPRING_PROFILES_ACTIVE=postgres

# Supabase PostgreSQL Connection Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://db.jqxxiexnlybfgvewpkyq.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_actual_supabase_password_here

# Python SimPy Discrete-Event Simulation Engine
SIMULATION_SERVICE_URL=http://localhost:8000

# Security (JWT)
JWT_SECRET=SuperSecretKeyForInsuranceClaimOperationsResearchProjectMustBeAtLeast256BitsLong

